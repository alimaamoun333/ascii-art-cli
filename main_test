func TestRun_Errors(t *testing.T) {
	tests := []struct {
		name        string
		args        []string
		errContains string
	}{
		{
			name:        "no arguments provided",
			args:        []string{"ascii-art"},
			errContains: "Usage:",
		},
		{
			name:        "unknown banner in normal mode",
			args:        []string{"ascii-art", "Hello", "unknown_banner"},
			errContains: "unsupported banner",
		},
		{
			name:        "unsupported color in color mode",
			args:        []string{"ascii-art", "--color=magenta_glow", "Hello"},
			errContains: "invalid or unsupported request color: magenta_glow",
		},
		{
			name:        "invalid alignment type",
			args:        []string{"ascii-art", "--align=diagonal", "Hello"},
			errContains: "Usage:",
		},
		{
			name:        "invalid output filename extension",
			args:        []string{"ascii-art", "--output=test.pdf", "Hello"},
			errContains: "Usage:",
		},
		{
			name:        "unsupported non-printable ASCII character",
			args:        []string{"ascii-art", "Hello\x01World"},
			errContains: "character does not exist",
		},
		{
			name:        "missing text in color mode",
			args:        []string{"ascii-art", "--color=red"},
			errContains: "Usage:",
		},
		{
			name:        "missing text in output mode",
			args:        []string{"ascii-art", "--output=valid.txt"},
			errContains: "Usage:",
		},
		{
			name:        "missing text in align mode",
			args:        []string{"ascii-art", "--align=center"},
			errContains: "Usage:",
		},
		{
			name:        "color mode missing target prefix for 3 args",
			args:        []string{"ascii-art", "--color=red", "no_target_prefix", "Hello", "shadow"},
			errContains: "Usage:",
		},
		{
			name:        "too many arguments in normal mode",
			args:        []string{"ascii-art", "Hello", "shadow", "extra"},
			errContains: "Usage:",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			oldArgs := os.Args
			defer func() { os.Args = oldArgs }()
			os.Args = tt.args

			err := run()
			if err == nil {
				t.Fatalf("run() with args %v expected error, got nil", tt.args)
			}
			if !strings.Contains(err.Error(), tt.errContains) {
				t.Errorf("run() error %q does not contain expected substring %q", err.Error(), tt.errContains)
			}
		})
	}
}

func TestMain_Success(t *testing.T) {
	oldArgs := os.Args
	defer func() { os.Args = oldArgs }()
	os.Args = []string{"ascii-art", "Hello"}

	output := captureStdout(func() {
		main()
	})

	if output == "" {
		t.Errorf("main() expected non-empty output, got empty string")
	}
}

func TestMain_Error(t *testing.T) {
	oldArgs := os.Args
	defer func() { os.Args = oldArgs }()
	os.Args = []string{"ascii-art"}

	output := captureStdout(func() {
		main()
	})

	if !strings.Contains(output, "Usage:") {
		t.Errorf("main() expected output to contain usage guide on error, got %q", output)
	}
}
